<Application x:Class="acut.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:acut.ViewModels"
             xmlns:views="clr-namespace:acut.Views"
             xmlns:conv="clr-namespace:acut.Converters">
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Styles/GameStyles.xaml" />
            <ResourceDictionary Source="Styles/CharacterStyles.xaml" />
            <ResourceDictionary Source="Styles/BattleStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />

        <!-- ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}"><views:MainMenuView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CharacterCreationViewModel}"><views:CharacterCreationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CityViewModel}"><views:CityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadingViewModel}"><views:LoadingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><views:InventoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CraftingViewModel}"><views:CraftingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BattleViewModel}"><views:BattleView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VictoryViewModel}"><views:VictoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
      </ResourceDictionary>
    </Application.Resources>
</Application>
