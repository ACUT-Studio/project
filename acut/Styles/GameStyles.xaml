<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:acut.Converters">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <SolidColorBrush x:Key="LobbyBackground" Color="#454545" />
    <SolidColorBrush x:Key="LobbyPanel" Color="#F6F3E9" />
    <Style x:Key="MenuButton" TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="LobbyCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LobbyPanel}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="6" />
    </Style>
    <Style x:Key="LobbyButton" TargetType="Button">
        <Setter Property="Background" Value="#E9D7A0" />
        <Setter Property="Foreground" Value="#252D2A" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style x:Key="LobbyStat" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F6F3E9" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0" />
    </Style>
    <Style x:Key="ValidationMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#A02B26" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <conv:BuildingTextureConverter x:Key="BuildingTexture" />
    <BitmapImage x:Key="BuildingAtlas" UriSource="/acut;component/Assets/Buildings/buildings-atlas.png" CacheOption="OnLoad" />
    <CroppedBitmap x:Key="BuildingTexture1" Source="{StaticResource BuildingAtlas}" SourceRect="0,0,512,512" />
    <CroppedBitmap x:Key="BuildingTexture2" Source="{StaticResource BuildingAtlas}" SourceRect="512,0,512,512" />
    <BitmapImage x:Key="BuildingTexture3" UriSource="/acut;component/Assets/Buildings/sawmill.png" />
    <CroppedBitmap x:Key="BuildingTexture4" Source="{StaticResource BuildingAtlas}" SourceRect="0,512,512,512" />
    <CroppedBitmap x:Key="BuildingTexture5" Source="{StaticResource BuildingAtlas}" SourceRect="512,512,512,512" />
    <CroppedBitmap x:Key="BuildingTexture6" Source="{StaticResource BuildingAtlas}" SourceRect="1024,512,512,512" />
    <CroppedBitmap x:Key="DefaultBuildingTexture" Source="{StaticResource BuildingAtlas}" SourceRect="0,0,512,512" />

    <Style x:Key="MapPanel" TargetType="Border">
        <Setter Property="Background" Value="#454545" />
        <Setter Property="BorderBrush" Value="#151715" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="TextElement.Foreground" Value="#FFF6D9" />
    </Style>
    <Style x:Key="HudCell" TargetType="Border" BasedOn="{StaticResource MapPanel}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="105" />
        <Setter Property="Height" Value="80" />
    </Style>
    <Style x:Key="MapAction" TargetType="Button">
        <Setter Property="Background" Value="#51534E" />
        <Setter Property="Foreground" Value="#FFF6D9" />
        <Setter Property="BorderBrush" Value="#151715" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#6F715F" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#EAD994" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#34382F" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MainMenuLogo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#111310" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="190" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="MainMenuAction" TargetType="Button" BasedOn="{StaticResource MapAction}">
        <Setter Property="Background" Value="#AAA599" />
        <Setter Property="Foreground" Value="#111310" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="114" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="MapDockAction" TargetType="Button" BasedOn="{StaticResource MapAction}">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="BuildingLevelBadge" TargetType="Border">
        <Setter Property="Background" Value="#E5252823" />
        <Setter Property="BorderBrush" Value="#AAA58B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextElement.Foreground" Value="#FFF6D9" />
        <Setter Property="TextElement.FontSize" Value="22" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MapBuilding" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Margin="6,6,30,30">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9D9F85" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#EAD994" /></Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#306F7859" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#EAD994" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DrawingBrush x:Key="CityPlotGround" Viewbox="0,0,260,220" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#454545" Geometry="M0,0 H260 V220 H0 Z" />
                <GeometryDrawing Brush="#393B37" Geometry="M0,196 H260 V220 H0 Z M236,0 H260 V220 H236 Z" />
                <GeometryDrawing Geometry="M0,196 H236 V0 M0,220 H260 V0">
                    <GeometryDrawing.Pen><Pen Brush="#151715" Thickness="2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingImage x:Key="PlayerPortrait">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#62665B" Geometry="M0,0 H100 V100 H0 Z" />
                <GeometryDrawing Brush="#B3AE95" Geometry="M50,20 A18,18 0 1 1 49.9,20 M15,94 C15,51 85,51 85,94 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="InventoryIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#EAE4CC" Geometry="M8,4 H40 V48 H8 Z">
                    <GeometryDrawing.Pen><Pen Brush="#141614" Thickness="3" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M14,15 H34 M14,24 H34 M14,33 H29">
                    <GeometryDrawing.Pen><Pen Brush="#41453B" Thickness="3" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PotionIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#D3C9BC" Geometry="M18,4 H30 V18 C52,42 38,52 24,52 C10,52 -4,42 18,18 Z">
                    <GeometryDrawing.Pen><Pen Brush="#242621" Thickness="2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#B85353" Geometry="M15,28 H33 C45,45 33,48 24,48 C15,48 3,45 15,28 Z" />
                <GeometryDrawing Brush="#6D4837" Geometry="M17,0 H31 V8 H17 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
