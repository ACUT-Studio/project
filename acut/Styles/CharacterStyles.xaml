<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Один шаблон для створення персонажа, інвентаря, портрета в місті та бою -->
    <DataTemplate x:Key="CharacterAppearanceTemplate">
        <Grid RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Image x:Name="CharacterSprite"
                   Source="pack://application:,,,/acut;component/Assets/Characters/skin_1.png"
                   Stretch="Uniform" />
        </Grid>
        <DataTemplate.Triggers>
            <!-- Базовий образ для кожного тону шкіри -->
            <DataTrigger Binding="{Binding SkinColor}" Value="Light">
                <Setter TargetName="CharacterSprite" Property="Source"
                        Value="pack://application:,,,/acut;component/Assets/Characters/skin_1.png" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SkinColor}" Value="Tan">
                <Setter TargetName="CharacterSprite" Property="Source"
                        Value="pack://application:,,,/acut;component/Assets/Characters/skin_2.png" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SkinColor}" Value="Dark">
                <Setter TargetName="CharacterSprite" Property="Source"
                        Value="pack://application:,,,/acut;component/Assets/Characters/skin_3.png" />
            </DataTrigger>

            <!-- Одяг Merchant з урахуванням тону шкіри -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Outfit}" Value="Merchant" />
                    <Condition Binding="{Binding SkinColor}" Value="Light" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CharacterSprite" Property="Source"
                        Value="pack://application:,,,/acut;component/Assets/Characters/outfit_1-skin_1.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Outfit}" Value="Merchant" />
                    <Condition Binding="{Binding SkinColor}" Value="Tan" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CharacterSprite" Property="Source"
                        Value="pack://application:,,,/acut;component/Assets/Characters/outfit_1-skin_2.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Outfit}" Value="Merchant" />
                    <Condition Binding="{Binding SkinColor}" Value="Dark" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CharacterSprite" Property="Source"
                        Value="pack://application:,,,/acut;component/Assets/Characters/outfit_1-skin_3.png" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="CharacterVisual" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CharacterCreationCard" TargetType="Border" BasedOn="{StaticResource LobbyCard}">
        <Setter Property="MaxWidth" Value="800" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="AppearanceLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppearanceChoice" TargetType="ComboBox">
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Value" />
        <Setter Property="Margin" Value="0,4,0,12" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style x:Key="CharacterPreviewPanel" TargetType="Border">
        <Setter Property="Background" Value="#6B3825" />
        <Setter Property="BorderBrush" Value="#DEAD6E" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="24,0,0,0" />
    </Style>

    <Style x:Key="CharacterPreviewHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFF2CF" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
</ResourceDictionary>