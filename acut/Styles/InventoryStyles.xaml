<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:items="clr-namespace:Acut.Core.Domain.Items;assembly=Acut.Core">
    <SolidColorBrush x:Key="InventoryBackground" Color="#6B3825" />
    <Style x:Key="InventoryPanel" TargetType="Border">
        <Setter Property="Background" Value="#8A5335" />
        <Setter Property="BorderBrush" Value="#DEAD6E" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="InventoryProfile" TargetType="Border">
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="InventoryHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFF2CF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="InventoryTitle" TargetType="TextBlock" BasedOn="{StaticResource InventoryHeading}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="InventoryCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F2D5AA" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,8" />
    </Style>
    <Style x:Key="InventoryAction" TargetType="Button" BasedOn="{StaticResource MapAction}">
        <Setter Property="Background" Value="#8A5335" />
        <Setter Property="BorderBrush" Value="#DEAD6E" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="120" />
    </Style>
    <Style x:Key="InventorySlot" TargetType="Button">
        <Setter Property="Height" Value="76" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="#81482E" />
        <Setter Property="BorderBrush" Value="#B98250" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#FFF2CF" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFF2CF" /></Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="#FFF2CF" />
                <Setter Property="Background" Value="#AE7447" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="InventoryQuantity" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFF2CF" />
        <Setter Property="Background" Value="#81482E" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style x:Key="InventoryValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFF2CF" />
        <Setter Property="Margin" Value="0,6,12,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="InventoryEquipmentSlot" TargetType="Button" BasedOn="{StaticResource InventoryAction}">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="76" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="#81482E" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="InventoryEquipmentLabel" TargetType="TextBlock" BasedOn="{StaticResource InventoryCaption}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="InventoryPauseNotice" TargetType="TextBlock" BasedOn="{StaticResource InventoryCaption}">
        <Setter Property="Foreground" Value="#FFF2B6" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="InventorySelectionHint" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EmptyInventoryMessage" TargetType="TextBlock" BasedOn="{StaticResource InventoryCaption}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="InventoryStatus" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFF2B6" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <DrawingImage x:Key="InventoryArmorIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#A9B7BB" Geometry="M6,4 L22,0 38,4 38,25 32,38 22,46 12,38 6,25 Z">
                    <GeometryDrawing.Pen><Pen Brush="#E2B451" Thickness="3" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#637782" Geometry="M22,6 L32,9 32,25 28,33 22,38 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DataTemplate DataType="{x:Type items:Weapon}"><Image Source="{StaticResource InventoryWeaponIcon}" Width="32" Height="38" /></DataTemplate>
    <DataTemplate DataType="{x:Type items:Armor}"><Image Source="{StaticResource InventoryArmorIcon}" Width="32" Height="38" /></DataTemplate>
    <DataTemplate DataType="{x:Type items:Potion}"><Image Source="{StaticResource PotionIcon}" Width="30" Height="38" /></DataTemplate>
    <DataTemplate DataType="{x:Type items:Item}"><Image Source="{StaticResource InventoryIcon}" Width="30" Height="38" /></DataTemplate>
</ResourceDictionary>
