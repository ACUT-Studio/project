<UserControl x:Class="acut.Views.VictoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource LobbyBackground}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700" Margin="24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BattleHeading}" FontSize="64" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EnemyName}" Style="{StaticResource BattleText}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource BattleHeading}" TextAlignment="Center" Margin="0,28,0,12" />
            <UniformGrid Columns="2" Margin="0,12,0,24">
                <Border Style="{StaticResource BattlePanel}"><TextBlock Text="{Binding RewardGold}" Style="{StaticResource BattleHeading}" TextAlignment="Center" /></Border>
                <Border Style="{StaticResource BattlePanel}"><TextBlock Text="{Binding RewardExperience}" Style="{StaticResource BattleHeading}" TextAlignment="Center" /></Border>
            </UniformGrid>
            <TextBlock Text="{Binding Level, StringFormat='Рівень героя: {0}'}" Style="{StaticResource BattleText}" HorizontalAlignment="Center" />
            <Button Content="Повернутися до міста" Command="{Binding BackCommand}" Style="{StaticResource BattleAction}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BattleText}" />
        </StackPanel>
    </Grid>
</UserControl>
