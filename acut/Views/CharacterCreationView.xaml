<UserControl x:Class="acut.Views.CharacterCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource LobbyBackground}">
        <Border Style="{StaticResource LobbyCard}" Width="390" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Створення персонажа" Style="{StaticResource Title}" FontSize="24" />
                <TextBlock Text="Ім'я" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                         Padding="8" AutomationProperties.Name="Ім'я персонажа" />
                <TextBlock Text="{Binding NameError}" Style="{StaticResource ValidationMessage}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Зачіска" />
                <ComboBox ItemsSource="{Binding HairStyles}" SelectedItem="{Binding HairStyle}" Margin="0,4,0,12" />
                <TextBlock Text="Колір шкіри" />
                <ComboBox ItemsSource="{Binding SkinColors}" SelectedItem="{Binding SkinColor}" Margin="0,4,0,12" />
                <TextBlock Text="Одяг" />
                <ComboBox ItemsSource="{Binding Outfits}" SelectedItem="{Binding Outfit}" Margin="0,4,0,16" />
                <Button Content="Почати гру" Command="{Binding ConfirmCommand}" Style="{StaticResource LobbyButton}" IsDefault="True" />
                <Button Content="Скасувати" Command="{Binding CancelCommand}" Style="{StaticResource LobbyButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
