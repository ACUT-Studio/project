<UserControl x:Class="acut.Views.CharacterCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource LobbyBackground}">
        <Border Style="{StaticResource CharacterCreationCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                <TextBlock Text="Створення персонажа" Style="{StaticResource Title}" FontSize="24" />
                <TextBlock Text="Ім'я" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                         Padding="8" AutomationProperties.Name="Ім'я персонажа" />
                <TextBlock Text="{Binding NameError}" Style="{StaticResource ValidationMessage}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Зачіска" Style="{StaticResource AppearanceLabel}" />
                <ComboBox x:Name="HairChoice" ItemsSource="{Binding HairStyles}" SelectedValue="{Binding HairStyle}"
                          Style="{StaticResource AppearanceChoice}" AutomationProperties.Name="Зачіска" />
                <TextBlock Text="Тон шкіри" Style="{StaticResource AppearanceLabel}" />
                <ComboBox x:Name="SkinChoice" ItemsSource="{Binding SkinColors}" SelectedValue="{Binding SkinColor}"
                          Style="{StaticResource AppearanceChoice}" AutomationProperties.Name="Тон шкіри" />
                <TextBlock Text="Одяг" Style="{StaticResource AppearanceLabel}" />
                <ComboBox x:Name="OutfitChoice" ItemsSource="{Binding Outfits}" SelectedValue="{Binding Outfit}"
                          Style="{StaticResource AppearanceChoice}" AutomationProperties.Name="Одяг" />
                <Button Content="Почати гру" Command="{Binding ConfirmCommand}" Style="{StaticResource LobbyButton}" IsDefault="True" />
                <Button Content="Скасувати" Command="{Binding CancelCommand}" Style="{StaticResource LobbyButton}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource CharacterPreviewPanel}">
                    <DockPanel>
                        <TextBlock Text="Попередній перегляд" DockPanel.Dock="Top" Style="{StaticResource CharacterPreviewHeading}" />
                        <ContentControl x:Name="AppearancePreview" Content="{Binding PreviewAppearance}" Style="{StaticResource CharacterVisual}"
                                        ContentTemplate="{StaticResource CharacterAppearanceTemplate}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
