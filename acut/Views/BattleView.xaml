<UserControl x:Class="acut.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Анімація випаду героя вперед при атаці -->
        <Storyboard x:Key="PlayerAttackStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayerMoveTransform"
                                           Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="54" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Анімація випаду ворога назустріч при контратаці -->
        <Storyboard x:Key="EnemyAttackStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EnemyMoveTransform"
                                           Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.09" Value="14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-54" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource LobbyBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Фон бойової арени (підвантажується безпечно з code-behind) -->
        <Image x:Name="BattleBackgroundImage"
               Grid.Row="0"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Верхня арена: ворог праворуч зверху, гравець ліворуч знизу -->
        <Grid Grid.Row="0" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Панель HP ворога -->
            <Border Style="{StaticResource BattlePanel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding EnemyName}" Style="{StaticResource BattleHeading}" />
                    <ProgressBar x:Name="EnemyHealthBar"
                                 Height="18"
                                 Foreground="#389E4A"
                                 Background="#222222"
                                 BorderThickness="0"
                                 Maximum="{Binding EnemyMaxHealth, Mode=OneWay}"
                                 Value="{Binding EnemyHealth, Mode=OneWay}"
                                 Margin="0,8" />
                    <TextBlock Style="{StaticResource BattleText}">
                        <Run Text="{Binding EnemyHealth, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding EnemyMaxHealth, Mode=OneWay}" />
                        <Run Text=" HP" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Спрайт ворога -->
            <Grid Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,115">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="EnemyMoveTransform" X="0" Y="0" />
                </Grid.RenderTransform>

                <Ellipse Style="{StaticResource BattlePlatform}"
                         Width="220" Height="28"
                         VerticalAlignment="Bottom"
                         Visibility="Collapsed" />

                <Image x:Name="EnemyPortraitImage"
                       Height="135"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,10"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />

                <Image x:Name="EnemyAttackSprite"
                       Height="135"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>

            <!-- Спрайт героя -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PlayerMoveTransform" X="0" Y="0" />
                </Grid.RenderTransform>

                <Ellipse Style="{StaticResource BattlePlatform}"
                         Width="220" Height="28"
                         VerticalAlignment="Bottom"
                         Visibility="Collapsed" />

                <ContentControl x:Name="PlayerAppearance"
                                Content="{Binding Appearance}"
                                Height="210"
                                Margin="0,0,0,10"
                                ContentTemplate="{StaticResource CharacterAppearanceTemplate}"
                                Style="{StaticResource CharacterVisual}" />

                <Image x:Name="PlayerAttackSprite"
                       Height="210"
                       Margin="0,0,0,10"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>

            <!-- Панель HP гравця -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BattlePanel}" VerticalAlignment="Bottom">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PlayerLevel, StringFormat='LVL {0}'}"
                                   Style="{StaticResource BattleText}" />
                        <TextBlock Text="{Binding PlayerName}" Style="{StaticResource BattleHeading}" />
                    </DockPanel>
                    <ProgressBar Height="18"
                                 Foreground="#389E4A"
                                 Background="#222222"
                                 BorderThickness="0"
                                 Maximum="{Binding PlayerMaxHealth, Mode=OneWay}"
                                 Value="{Binding PlayerHealth, Mode=OneWay}"
                                 Margin="0,8" />
                    <TextBlock Style="{StaticResource BattleText}">
                        <Run Text="{Binding PlayerHealth, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding PlayerMaxHealth, Mode=OneWay}" />
                        <Run Text=" HP" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижня панель: журнал бою ліворуч, кнопки дій праворуч -->
        <Grid Grid.Row="1" Margin="18,0,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource BattlePanel}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding TurnText}"
                               Style="{StaticResource BattleHeading}"
                               Margin="0,0,0,10" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource BattleText}"
                               Foreground="#F1DB94"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource BattleText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="3">
                    <Button Content="Атака"
                            Command="{Binding AttackCommand}"
                            Click="AttackButton_Click"
                            Style="{StaticResource BattleAction}"
                            Margin="0,0,8,0" />
                    <Button Content="Захист"
                            Command="{Binding DefendCommand}"
                            Click="TurnActionButton_Click"
                            Style="{StaticResource BattleAction}"
                            Margin="4,0" />
                    <Button Content="Зілля"
                            Command="{Binding UseItemCommand}"
                            Click="TurnActionButton_Click"
                            Style="{StaticResource BattleAction}"
                            Margin="8,0,0,0" />
                </UniformGrid>

                <ComboBox Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          DisplayMemberPath="Display"
                          Margin="0,10,0,0"
                          Padding="8,5" />

                <Button Grid.Row="2"
                        Content="Результат"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource BattleAction}"
                        Margin="0,10,0,0" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>