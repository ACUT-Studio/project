<UserControl x:Class="acut.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource LobbyBackground}" Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
        <Grid Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource BattlePanel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding EnemyName}" Style="{StaticResource BattleHeading}" />
                    <ProgressBar x:Name="EnemyHealthBar" Value="{Binding EnemyHealth, Mode=OneWay}" Maximum="{Binding EnemyMaxHealth}" Style="{StaticResource BattleHealth}" />
                    <TextBlock Style="{StaticResource BattleText}"><Run Text="{Binding EnemyHealth, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding EnemyMaxHealth, Mode=OneWay}" /><Run Text=" HP" /></TextBlock>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="26,0,26,8">
                <Ellipse Style="{StaticResource BattlePlatform}" />
                <Image Source="{StaticResource EnemyPortrait}" Height="120" Margin="0,0,0,18" VerticalAlignment="Bottom" AutomationProperties.Name="Ворог" />
            </Grid>
            <Grid Grid.Row="1" Margin="26,0,26,0">
                <Ellipse Style="{StaticResource BattlePlatform}" />
                <ContentControl x:Name="PlayerAppearance" Content="{Binding Appearance}" Height="140" Margin="0,0,0,18" VerticalAlignment="Bottom"
                                ContentTemplate="{StaticResource CharacterAppearanceTemplate}" Style="{StaticResource CharacterVisual}" AutomationProperties.Name="Герой" />
            </Grid>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BattlePanel}" VerticalAlignment="Bottom">
                <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding PlayerLevel, StringFormat='LVL {0}'}" Style="{StaticResource BattleText}" />
                        <TextBlock Text="{Binding PlayerName}" Style="{StaticResource BattleHeading}" /></DockPanel>
                    <ProgressBar x:Name="PlayerHealthBar" Value="{Binding PlayerHealth, Mode=OneWay}" Maximum="{Binding PlayerMaxHealth}" Style="{StaticResource BattleHealth}" />
                    <TextBlock Style="{StaticResource BattleText}"><Run Text="{Binding PlayerHealth, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding PlayerMaxHealth, Mode=OneWay}" /><Run Text=" HP" /></TextBlock>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="18,0,18,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource BattlePanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TurnText}" Style="{StaticResource BattleHeading}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource BattleText}" />
                    <ListBox x:Name="BattleLog" ItemsSource="{Binding Log}" Background="Transparent" Foreground="#FFF6D9" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Журнал ходів">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <DockPanel Grid.Column="1" Margin="8">
                <Button DockPanel.Dock="Bottom" Content="Результат" Command="{Binding ContinueCommand}" Style="{StaticResource BattleAction}" />
                <ComboBox DockPanel.Dock="Bottom" x:Name="BattleItems" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="6" MinHeight="30" AutomationProperties.Name="Предмет для бою">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Item.Name, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Quantity, Mode=OneWay}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <UniformGrid Rows="1" Columns="3">
                    <Button x:Name="AttackButton" Content="Атака" Command="{Binding AttackCommand}" Style="{StaticResource BattleAction}" />
                    <Button Content="Захист" Command="{Binding DefendCommand}" Style="{StaticResource BattleAction}" />
                    <Button x:Name="UseItemButton" Content="Зілля" Command="{Binding UseItemCommand}" Style="{StaticResource BattleAction}" />
                </UniformGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
