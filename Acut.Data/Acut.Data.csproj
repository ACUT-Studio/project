<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acut.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acut.Core\Acut.Core.csproj" />
  </ItemGroup>

  <!-- schema.sql, seed.sql і майбутні migration_NNN.sql вбудовуються в збірку під іменем файлу -->
  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
